---
import type { Story } from '../lib/content';
interface Props { story: Story; index: number; featured?: boolean; }
const { story, index, featured = false } = Astro.props;
---
<article class:list={['story-card', { featured }]}>
  <a class="story-image-link" href={`/lives/${story.lifeId}/stories/${story.id}/`} tabindex="-1" aria-hidden="true">
    {story.imageUrl ? <img src={story.imageUrl} alt="" loading="lazy" width="1000" height="700" /> : <div class="text-story-art"><span>{story.title.slice(0, 1)}</span></div>}
    <span class="photo-index">{String(index + 1).padStart(2, '0')}</span>
    <span class="image-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="story-card-copy">
    <p class="eyebrow">{story.category || 'A story'}<span class="dot">·</span>{story.readingMinutes} min read</p>
    <h3><a href={`/lives/${story.lifeId}/stories/${story.id}/`}>{story.title}</a></h3>
    <p>{story.excerpt}</p>
    {story.date && <span class="story-date">{story.date}</span>}
  </div>
</article>
