{
  "name": "mylifebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An open, portable home for the stories that make a life.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "build:edition": "node scripts/build-edition.mjs",
    "check": "astro check",
    "test": "node --import tsx --test tests/content.test.ts tests/import.test.ts",
    "test:output": "node --import tsx --test tests/output.test.ts",
    "test:browser": "playwright test",
    "import": "node scripts/import.mjs",
    "print:proof": "node scripts/print-proof.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/source-sans-3": "^5.2.9",
    "astro": "^7.3.3",
    "gray-matter": "^4.0.3",
    "mammoth": "^1.12.3",
    "marked": "^17.0.4",
    "sanitize-html": "^2.17.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
